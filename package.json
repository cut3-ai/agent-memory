{
  "name": "@cut3/agent-memory",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.js",
    "VERIFY.md"
  ],
  "exports": {
    "./core/*": "./src/core/*.js",
    "./units/*": "./src/units/*.js",
    "./behaviours/*": "./src/behaviours/*.js",
    "./compositions/*": "./src/compositions/*.js",
    "./online/*": "./src/online/*.js",
    "./drivers/react": "./src/drivers/react.js",
    "./drivers/remotion": "./src/drivers/remotion.js",
    "./catalog": "./src/catalog.js"
  },
  "scripts": {
    "test": "node --test \"misc/test-runs/tests/*.test.js\"",
    "showcase": "node misc/test-runs/render-showcase.js",
    "showcase:browser": "node misc/test-runs/render-browser-showcase.js"
  },
  "engines": {
    "node": ">=22"
  }
}
