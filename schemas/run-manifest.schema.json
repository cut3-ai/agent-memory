{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cut3-ai/agent-memory/schemas/run-manifest.schema.json",
  "title": "Deterministic mining run manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "algorithmVersion",
    "algorithmDigest",
    "input",
    "config",
    "humanFeedbackAvailable",
    "promotionAllowed",
    "counts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-f0-9]{20}$" },
    "algorithmVersion": { "type": "string" },
    "algorithmDigest": { "type": "string", "pattern": "^[a-f0-9]{20}$" },
    "input": {
      "type": "object",
      "required": ["format", "sha256", "jsonlLines"],
      "properties": {
        "format": { "const": "workspace-jsonl" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "jsonlLines": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "config": { "type": "object" },
    "humanFeedbackAvailable": { "const": false },
    "promotionAllowed": { "const": false },
    "counts": { "type": "object" }
  },
  "additionalProperties": false
}
