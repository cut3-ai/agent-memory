{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cut3-ai/agent-memory/schemas/preview-index.schema.json",
  "title": "Experimental memory discovery index",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "humanFeedbackAvailable",
    "promotionAllowed",
    "warning",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-f0-9]{20}$" },
    "status": { "const": "experimental" },
    "humanFeedbackAvailable": { "const": false },
    "promotionAllowed": { "const": false },
    "warning": { "type": "string" },
    "entries": {
      "type": "array",
      "items": { "$ref": "index-entry.schema.json" }
    }
  },
  "additionalProperties": false
}
