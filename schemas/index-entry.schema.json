{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cut3-ai/agent-memory/schemas/index-entry.schema.json",
  "title": "Generated atomic memory index entry",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "state",
    "feedback",
    "trusted",
    "maturity",
    "confidence",
    "extraction",
    "atomicity",
    "description",
    "intents",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "kind": { "enum": ["behavior", "unit"] },
    "status": { "const": "observed" },
    "state": { "const": "suggested" },
    "feedback": { "const": "unknown" },
    "trusted": { "const": false },
    "maturity": { "enum": ["strong", "promising", "experimental"] },
    "description": { "type": "string", "minLength": 1 },
    "atomicity": {
      "type": "object",
      "required": ["boundary", "multiplicity"],
      "properties": {
        "boundary": { "enum": ["single-renderable", "single-visual-channel"] },
        "multiplicity": { "const": "one-definition-many-instances" }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": ["score", "tier", "meaning", "components", "penalties"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "tier": { "enum": ["strong-review", "review", "inventory-only"] },
        "meaning": { "type": "string", "minLength": 1 },
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "penalties": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "required": ["state", "spansAvailable", "localCohesion", "atomicOccurrences", "spanSource"],
      "properties": {
        "state": { "enum": ["atomic-occurrences-located", "extracted"] },
        "spansAvailable": { "const": true },
        "localCohesion": { "type": "number", "minimum": 0, "maximum": 1 },
        "atomicOccurrences": { "type": "integer", "minimum": 1 },
        "spanSource": { "const": "normalized-composition" }
      },
      "additionalProperties": false
    },
    "intents": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "observations",
        "independentOccurrences",
        "supportBasis",
        "uniqueSources",
        "distinctImplementations",
        "workspaces",
        "acceptedPositive",
        "acceptedNeutral",
        "rejected",
        "sampleObservationIds",
        "sampleOccurrences"
      ],
      "properties": {
        "observations": { "type": "integer", "minimum": 1 },
        "independentOccurrences": { "type": "integer", "minimum": 1 },
        "supportBasis": { "const": "local-ast-occurrences" },
        "uniqueSources": { "type": "integer", "minimum": 1 },
        "distinctImplementations": { "type": "integer", "minimum": 1 },
        "workspaces": { "type": "integer", "minimum": 1 },
        "acceptedPositive": { "const": 0 },
        "acceptedNeutral": { "const": 0 },
        "rejected": { "const": 0 },
        "sampleObservationIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/observationId" },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "sampleOccurrences": {
          "type": "array",
          "items": { "$ref": "#/$defs/localOccurrence" },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "propsSchema": { "$ref": "#/$defs/embeddedObjectSchema" },
    "providesCapabilities": { "$ref": "#/$defs/capabilities" },
    "configSchema": { "$ref": "#/$defs/embeddedObjectSchema" },
    "requiresCapabilities": { "$ref": "#/$defs/capabilities" },
    "writes": {
      "type": "array",
      "items": { "$ref": "#/$defs/atomicWrite" },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    }
  },
  "oneOf": [
    {
      "title": "Renderable unit",
      "required": ["propsSchema", "providesCapabilities"],
      "properties": {
        "kind": { "const": "unit" },
        "id": { "$ref": "#/$defs/unitId" },
        "atomicity": {
          "type": "object",
          "properties": {
            "boundary": { "const": "single-renderable" }
          }
        },
        "propsSchema": { "$ref": "#/$defs/embeddedObjectSchema" },
        "providesCapabilities": { "$ref": "#/$defs/capabilities" },
        "configSchema": false,
        "requiresCapabilities": false,
        "writes": false
      }
    },
    {
      "title": "Single-channel behavior",
      "required": ["configSchema", "requiresCapabilities", "writes"],
      "properties": {
        "kind": { "const": "behavior" },
        "id": { "$ref": "#/$defs/behaviorId" },
        "atomicity": {
          "type": "object",
          "properties": {
            "boundary": { "const": "single-visual-channel" }
          }
        },
        "configSchema": { "$ref": "#/$defs/embeddedObjectSchema" },
        "requiresCapabilities": { "$ref": "#/$defs/capabilities" },
        "writes": {
          "type": "array",
          "items": { "$ref": "#/$defs/atomicWrite" },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "propsSchema": false,
        "providesCapabilities": false
      }
    }
  ],
  "$defs": {
    "unitId": {
      "type": "string",
      "pattern": "^(?:audio|card|draw|layout|media|overlay|text|three)\\.[a-z][a-z0-9-]*$"
    },
    "behaviorId": {
      "type": "string",
      "pattern": "^(?:effect|motion|timing|transition)\\.[a-z][a-z0-9-]*$"
    },
    "atomicWrite": {
      "enum": [
        "opacity",
        "transform.scale",
        "transform.translate",
        "transform.rotate",
        "filter"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "embeddedObjectSchema": {
      "type": "object",
      "required": ["type", "properties", "required", "additionalProperties"],
      "properties": {
        "type": { "const": "object" },
        "properties": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "additionalProperties": { "const": false }
      },
      "additionalProperties": false
    },
    "observationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "localOccurrence": {
      "type": "object",
      "required": ["observationId", "span", "dependencySpans"],
      "properties": {
        "observationId": { "$ref": "#/$defs/observationId" },
        "span": { "$ref": "#/$defs/span" },
        "dependencySpans": {
          "type": "array",
          "items": { "$ref": "#/$defs/span" }
        },
        "channel": { "$ref": "#/$defs/atomicWrite" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
