{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cut3-ai/agent-memory/schemas/timeline-arrangement.schema.json",
  "title": "Non-memory timeline arrangement diagnostic",
  "type": "object",
  "required": [
    "id",
    "kind",
    "memoryEligible",
    "description",
    "intents",
    "evidenceObservationIds",
    "workspaceIndexes",
    "evidenceOccurrences",
    "why"
  ],
  "properties": {
    "id": {
      "enum": [
        "arrangement.photo-flash-cuts",
        "arrangement.repeated-ranking-card",
        "arrangement.repeated-timed-word-scatter",
        "arrangement.repeated-dialogue-card"
      ]
    },
    "kind": { "const": "arrangement-diagnostic" },
    "memoryEligible": { "const": false },
    "description": { "type": "string", "minLength": 1 },
    "intents": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidenceObservationIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/observationId" },
      "minItems": 1,
      "uniqueItems": true
    },
    "workspaceIndexes": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidenceOccurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workspaceIndex", "observationIds"],
        "properties": {
          "workspaceIndex": { "type": "integer", "minimum": 0 },
          "observationIds": {
            "type": "array",
            "items": { "$ref": "#/$defs/observationId" },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "why": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "observationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
